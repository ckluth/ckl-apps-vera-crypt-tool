<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CKL.Apps.VeraCryptTool</AssemblyName>
    <RootNamespace>CKL.Apps.VeraCryptTool</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CKL.Libs.Crypt" Version="3.0.0" />
    <PackageReference Include="CKL.Libs.ResultPattern" Version="1.0.0" />
  </ItemGroup>
</Project>
